# ─────────────────────────────────────────────────────────────────────
# PLICA – Konfiguration für den Produktivbetrieb mit compose.yml
#   cp .env.example .env   und alle Werte mit <…> ersetzen.
# Geheimnisse erzeugen:  openssl rand -hex 32
# Diese Datei enthält KEINE echten Zugangsdaten. .env niemals einchecken.
# ─────────────────────────────────────────────────────────────────────

# Öffentliche Adresse der Verwaltung (ohne Schrägstrich am Ende).
# Mit https:// werden Cookies automatisch als „Secure“ markiert und HSTS gesetzt.
APP_URL=https://plica.example.de

# Optional: eigene Domain nur für öffentliche Formulare (z. B. https://formulare.example.de).
# Auf dieser Domain ist die Verwaltung nicht erreichbar.
# PUBLIC_URL=

# Hauptschlüssel für Verschlüsselung (TOTP-Geheimnisse, Zwischenstände, Webhook-Geheimnisse)
# und Signaturen. Mindestens 32 Zeichen. Nach dem Start NICHT mehr ändern.
SECRET_KEY=<openssl rand -hex 32>

# production | development | test
PLICA_ENV=production

# Image und Netzwerk ───────────────────────────────────────────────────
# Image (Standard: lokal gebautes plica:local)
# PLICA_IMAGE=ghcr.io/<organisation>/plica:0.1.0
# Bindung des App-Ports. 127.0.0.1 = nur für den Reverse Proxy auf demselben Server.
PLICA_BIND=127.0.0.1
PLICA_PORT=3000
# Hinter einem Reverse Proxy: X-Forwarded-For für Ratenbegrenzung auswerten.
TRUST_PROXY=true

# Datenbank (PostgreSQL 18 im Container) ──────────────────────────────
POSTGRES_USER=plica
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=plica
# DATABASE_URL wird in compose.yml aus diesen Werten gebildet.
# Für eine externe Datenbank DATABASE_URL in compose.yml (x-app-env) anpassen.

# Dateien (S3-kompatibler Speicher „storage“ im Container, RustFS) ────
S3_ROOT_USER=plica
S3_ROOT_PASSWORD=<openssl rand -hex 24>
S3_BUCKET=plica
S3_REGION=us-east-1
# Für externen S3-Speicher (z. B. Hetzner/Netcup Object Storage) S3_ENDPOINT/S3_ACCESS_KEY/S3_SECRET_KEY in compose.yml (x-app-env) anpassen.
# S3_FORCE_PATH_STYLE=true

# Uploads ──────────────────────────────────────────────────────────────
# Obergrenze pro Datei in MB (Formulare können niedrigere Grenzen setzen).
UPLOAD_MAX_MB=25
# Virenscanner (clamd). Ohne Scanner landen Uploads in Quarantäne und müssen vor
# dem Öffnen freigegeben werden. Mit: docker compose --profile clamav up -d
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310

# E-Mail ───────────────────────────────────────────────────────────────
# SMTP-Server für Benachrichtigungen und Bestätigungen.
# Beispiele: smtps://benutzer:passwort@smtp.example.de:465
#            smtp://benutzer:passwort@smtp.example.de:587
# Ohne SMTP_URL werden keine E-Mails versendet (Schritte schlagen protokolliert fehl).
# SMTP_URL=
MAIL_FROM="PLICA <formulare@example.de>"

# Einbettung ───────────────────────────────────────────────────────────
# Wo Formulare per iframe eingebettet werden dürfen (CSP frame-ancestors).
# "*" = überall, sonst Liste: "https://www.example.de https://example.de"
EMBED_ORIGINS=*

# Webhooks ─────────────────────────────────────────────────────────────
# Webhooks an private Netze (192.168.x, 10.x, localhost) sind aus SSRF-Schutz gesperrt.
# Nur einschalten, wenn interne Systeme (z. B. j-lawyer im LAN) beliefert werden sollen.
WEBHOOK_ALLOW_PRIVATE=false

# Sicherungen ──────────────────────────────────────────────────────────
# Anzahl aufbewahrter automatischer Sicherungen (plica backup --auto).
BACKUP_KEEP=14

# Worker ───────────────────────────────────────────────────────────────
# Parallel verarbeitete Jobs pro Worker.
# WORKER_CONCURRENCY=4

# Ersteinrichtung ──────────────────────────────────────────────────────
# Fester Einrichtungscode (nur für automatisierte Installationen/Tests).
# Ohne Angabe erzeugt PLICA einen Code und schreibt ihn ins Log.
# SETUP_CODE=

# Anmeldung über OIDC (z. B. authentik, Keycloak) ─────────────────────
# Optional. SSO ist aktiv, sobald OIDC_ISSUER gesetzt ist. Details: docs/handbuch/21-konfiguration.md
# OIDC_ISSUER=https://login.example.de/application/o/plica/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Single Sign-on
# OIDC_ALLOWED_GROUPS=
# OIDC_ADMIN_GROUPS=
# OIDC_AUTO_CREATE_USERS=false
# OIDC_DEFAULT_ROLE=
# OIDC_LOGOUT=false
# Passwort-Anmeldung bei aktivem SSO ausblenden (Notzugang bleibt unter /login?lokal=1)
# LOCAL_LOGIN=visible

# Optionale KI (OpenAI-kompatible API, z. B. lokal mit Ollama) ─────────
# PLICA funktioniert vollständig ohne KI.
# AI_BASE_URL=http://ollama:11434/v1
# AI_API_KEY=
# AI_MODEL=llama3.1
