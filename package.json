{
  "name": "plica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:init": "node scripts/dev-init.mjs",
    "dev": "next dev -p 4700",
    "build": "next build",
    "start": "next start -p 4700",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker": "node scripts/build-node.mjs && node --env-file-if-exists=.env.local --enable-source-maps dist/worker.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "dev:services": "docker compose -f docker/compose.dev.yml up -d",
    "cli": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx src/cli/main.ts",
    "build:worker": "node scripts/build-node.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "docs:abnahme": "node scripts/handbuch-abnahme.mjs",
    "build:node": "node scripts/build-node.mjs",
    "test:lifecycle": "bash scripts/docker-lifecycle-test.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "file-type": "^22.2.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.5.0",
    "next": "16.4.6",
    "nodemailer": "^10.2.0",
    "openid-client": "^6.8.8",
    "otplib": "^13.5.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "re2js": "^2.9.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.4"
}
